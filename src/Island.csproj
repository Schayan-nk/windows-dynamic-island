<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Island</AssemblyName>
    <RootNamespace>Island</RootNamespace>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Island</Product>
    <Description>A dynamic island for Windows 11</Description>
    <NoWarn>$(NoWarn);CA1416;WFO1000;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\island.ico" />
    <None Remove="Assets\island-preview.png" />
    <EmbeddedResource Include="Web\phone.html" LogicalName="phone.html" />
  </ItemGroup>

</Project>
