<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island"
        Title="Island" Width="800" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="White"
        AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid x:Name="Root">
        <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Top" Width="190" Height="32"
              MouseEnter="Host_MouseEnter" MouseLeave="Host_MouseLeave" MouseLeftButtonUp="Host_MouseLeftButtonUp"
              DragEnter="Host_DragEnter" DragOver="Host_DragOver" DragLeave="Host_DragLeave" Drop="Host_Drop">

            <!-- The glow is blurred once and kept as a bitmap, so pulsing only fades that picture:
                 re-blurring it whenever anything on the island changed was most of the CPU the island used. -->
            <Border x:Name="GlowFade" IsHitTestVisible="False">
                <Border x:Name="Glow" Opacity="0">
                    <Border.CacheMode>
                        <BitmapCache />
                    </Border.CacheMode>
                    <Border x:Name="GlowShape" Background="#050506" CornerRadius="0,0,16,16">
                        <Border.Effect>
                            <DropShadowEffect x:Name="GlowFx" BlurRadius="22" ShadowDepth="0" Color="#FF8A4C" Opacity="1" />
                        </Border.Effect>
                    </Border>
                </Border>
            </Border>

            <Border x:Name="Pill" CornerRadius="0,0,16,16">
                <Grid>
                    <!-- Collapsed / live activity -->
                    <Grid x:Name="CompactContent" Height="32" VerticalAlignment="Top" Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="LiveLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <local:ClaudeMark x:Name="LiveSpark" Width="15" Height="15" Visibility="Collapsed" />
                            <Border x:Name="LiveArt" Width="20" Height="20" CornerRadius="6" Visibility="Collapsed" Background="#33FFFFFF" />
                            <local:Ring x:Name="LiveRing" Width="16" Height="16" Thickness="2.6" Fill="#C49BFF" Visibility="Collapsed" />
                            <TextBlock x:Name="IdleTime" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                        </StackPanel>
                        <local:EyesView x:Name="CompactEyes" Grid.Column="1" Width="30" Height="12" VerticalAlignment="Center" />
                        <StackPanel x:Name="LiveRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LiveText" FontSize="12.5" FontWeight="SemiBold" Visibility="Collapsed" />
                            <local:LevelBars x:Name="LiveBars" Width="18" Height="12" Visibility="Collapsed" />
                            <StackPanel x:Name="IdleBattery" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="20" Height="10" VerticalAlignment="Center">
                                    <Border BorderBrush="#B3FFFFFF" BorderThickness="1.2" CornerRadius="3" Margin="0,0,2,0" />
                                    <Border x:Name="IdleBatteryFill" Background="White" CornerRadius="1.5" Margin="2.2,2.2,4.2,2.2" HorizontalAlignment="Left" Width="10" />
                                    <Border Background="#B3FFFFFF" Width="1.6" Height="4" CornerRadius="0.8" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="IdleBatteryText" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Notification pop -->
                    <Grid x:Name="PopContent" Visibility="Collapsed" Height="76" VerticalAlignment="Top" Margin="16,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PopBadge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" Background="#30D158">
                            <TextBlock x:Name="PopGlyph" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE73E;" />
                        </Border>
                        <Canvas x:Name="PopSparkles" Width="44" Height="44" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PopTitle" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PopText" FontSize="12.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                       MaxHeight="36" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Drop zone: the mascot follows the pointer and eats the file -->
                    <Grid x:Name="DropContent" Visibility="Collapsed" Width="640" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Rectangle x:Name="DropDash" Margin="16,10,16,16" RadiusX="22" RadiusY="22" Stroke="#FFC83D"
                                   StrokeThickness="2" StrokeDashArray="5 4" StrokeDashCap="Round" />
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                            <local:TrayGlyph Width="24" Height="24" Stroke="#FFC83D" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropTitle" Text="Let go, I'll catch it!" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,2" />
                            <TextBlock x:Name="DropSub" Text="The file goes into your tray" FontSize="12.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Canvas x:Name="DropStage" IsHitTestVisible="False">
                            <Border x:Name="DropFile" Width="44" Height="44" CornerRadius="11" Background="#33FFFFFF" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="DropFileScale" />
                                </Border.RenderTransform>
                            </Border>
                            <local:Mascot x:Name="Mochi" Width="60" Height="54" Canvas.Left="290" Canvas.Top="140" RenderTransformOrigin="0.5,1">
                                <local:Mascot.Effect>
                                    <DropShadowEffect Color="#FFE7A6" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
                                </local:Mascot.Effect>
                                <local:Mascot.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MochiScale" />
                                        <RotateTransform x:Name="MochiTilt" />
                                        <TranslateTransform x:Name="MochiLift" />
                                    </TransformGroup>
                                </local:Mascot.RenderTransform>
                            </local:Mascot>
                            <Canvas x:Name="DropSparkles" />
                        </Canvas>
                    </Grid>

                    <!-- Receiving from the phone: the mascot rides the progress bar -->
                    <Grid x:Name="ProgressContent" Visibility="Collapsed" Width="460" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid Margin="26,16,26,0">
                            <TextBlock x:Name="ProgressTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                            <TextBlock x:Name="ProgressPct" FontSize="13" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                            <Grid x:Name="ProgressTrack" Height="26" VerticalAlignment="Top" Margin="0,28,0,0">
                                <Border Height="6" CornerRadius="3" Background="#26FFFFFF" VerticalAlignment="Center" />
                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2BB673" Offset="0" />
                                            <GradientStop Color="#5BE39A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ProgressFill" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <Canvas>
                                    <local:Mascot x:Name="ProgressMochi" Width="24" Height="22" Canvas.Top="2" Canvas.Left="-12" Look="1" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Expanded -->
                    <Grid x:Name="ExpandedContent" Visibility="Hidden" Width="720" Height="292" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid Margin="20,4,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderA" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HeaderB" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:EyesView x:Name="HeaderEyes" Width="26" Height="11" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeaderDate" Foreground="{StaticResource Dim}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HeaderTime" FontWeight="SemiBold" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderNote" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <local:LevelBars x:Name="HeaderBars" Width="20" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Button x:Name="FolderBtn" Style="{StaticResource IconBtn}" Content="&#xE8B7;" ToolTip="Open the project folder" Click="FolderBtn_Click" Visibility="Collapsed" />
                                    <Button x:Name="PhoneBtn" Style="{StaticResource IconBtn}" Content="&#xE8EA;" ToolTip="Share with your phone" Click="PhoneBtn_Click" Visibility="Collapsed" />
                                    <Button x:Name="ClearBtn" Style="{StaticResource PillBtn}" Background="#3A1518" Foreground="#FF6B6B" Content="Clear all" Margin="6,0" Click="ClearBtn_Click" Visibility="Collapsed" />
                                    <Button x:Name="MoreBtn" Style="{StaticResource IconBtn}" Content="&#xE712;" ToolTip="Settings" Click="MoreBtn_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Body -->
                            <Grid x:Name="Body" Grid.Row="1">

                                <!-- Home -->
                                <StackPanel x:Name="HomePanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="TileClaude" Width="212" Height="172" CornerRadius="22" Margin="0,0,10,0" Cursor="Hand" BorderBrush="#24FFFFFF" BorderThickness="1"
                                            MouseLeftButtonUp="TileClaude_Click" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#161616" Offset="0.05" />
                                                <GradientStop x:Name="TileClaudeStop" Color="#B5693F" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Margin="16,14,16,14">
                                            <TextBlock Text="Claude Code" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF" VerticalAlignment="Top" />
                                            <Grid Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Context window used by the latest session">
                                                <local:Ring x:Name="ClaudeRing" Thickness="4" RenderTransformOrigin="0.5,0.5">
                                                    <local:Ring.RenderTransform>
                                                        <RotateTransform x:Name="ClaudeRingSpin" />
                                                    </local:Ring.RenderTransform>
                                                </local:Ring>
                                                <TextBlock x:Name="ClaudeRingText" Text="0%" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <local:ClaudeMark x:Name="ClaudeRingMark" Width="16" Height="16" Fill="White" Visibility="Collapsed" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock x:Name="ClaudeTileBig" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ClaudeTileSub" Text="jobs today" FontSize="13" Foreground="#E0FFFFFF" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border x:Name="TileClaudeFlash" CornerRadius="21" Background="White" Opacity="0" Margin="-16,-14,-16,-14" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="TileMusic" Width="212" Height="172" CornerRadius="22" Margin="0,0,10,0" Cursor="Hand" BorderBrush="#24FFFFFF" BorderThickness="1"
                                            MouseLeftButtonUp="TileMusic_Click" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1A0A0D" Offset="0.05" />
                                                <GradientStop Color="#C23A4C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Margin="16,14,16,14">
                                            <TextBlock Text="Music" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF" VerticalAlignment="Top" />
                                            <local:LevelBars x:Name="TileBars" Width="16" Height="10" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,24,0,0" Visibility="Collapsed" />
                                            <Border x:Name="TileMusicArt" Width="54" Height="54" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#40000000">
                                                <TextBlock x:Name="TileMusicGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,40,0">
                                                <TextBlock x:Name="MusicTileBig" Text="Spotify" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="MusicTileSub" Text="Connect your music" FontSize="13" Foreground="#E0FFFFFF" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button x:Name="TilePlay" Style="{StaticResource CircleBtn}" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Click="TilePlay_Click" Visibility="Collapsed">
                                                <TextBlock x:Name="TilePlayGlyph" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#111" />
                                            </Button>
                                            <Border x:Name="TileMusicFlash" CornerRadius="21" Background="White" Opacity="0" Margin="-16,-14,-16,-14" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="TileFocus" Width="212" Height="172" CornerRadius="22" Cursor="Hand" BorderBrush="#24FFFFFF" BorderThickness="1"
                                            MouseLeftButtonUp="TileFocus_Click" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#15101F" Offset="0.05" />
                                                <GradientStop Color="#9D5BD2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Margin="16,14,16,14">
                                            <TextBlock Text="Focus" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF" VerticalAlignment="Top" />
                                            <Grid Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <local:Ring x:Name="FocusTileRing" Thickness="3" Visibility="Collapsed" />
                                                <Button x:Name="FocusTileBtn" Style="{StaticResource CircleBtn}" Width="40" Height="40" Click="FocusTileBtn_Click">
                                                    <TextBlock x:Name="FocusTileGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#8E4BD6" />
                                                </Button>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock x:Name="FocusTileBig" Text="25:00" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" />
                                                <TextBlock x:Name="FocusTileSub" Text="Ready to start" FontSize="13" Foreground="#E0FFFFFF" />
                                            </StackPanel>
                                            <Border x:Name="TileFocusFlash" CornerRadius="21" Background="White" Opacity="0" Margin="-16,-14,-16,-14" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Claude Code -->
                                <Grid x:Name="ClaudePanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="2,4,10,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="6" Background="#E2885F">
                                                <local:ClaudeMark Width="13" Height="13" Fill="White" />
                                            </Border>
                                            <TextBlock x:Name="ClaudeProject" Text="No session yet" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        </StackPanel>
                                        <TextBlock x:Name="ClaudeElapsed" Text="0:00" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <TextBlock x:Name="ClaudeStatus" FontSize="13.5" Foreground="#E0FFFFFF" Margin="0,-4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ClaudeOthers" FontSize="12" Foreground="{StaticResource Dimmer}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Border x:Name="ClaudeCard" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0" CornerRadius="14"
                                            Background="#26000000" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12,10">
                                        <StackPanel>
                                            <Grid x:Name="ClaudeFileRow">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="4" Background="#33FFFFFF" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ClaudeExt" Text="TS" FontSize="10.5" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock x:Name="ClaudeFile" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="ClaudeFileVerb" HorizontalAlignment="Right" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="DiffOldRow" CornerRadius="5" Background="#40FF5A5A" Margin="0,8,0,0" Padding="8,3">
                                                <TextBlock x:Name="DiffOld" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border x:Name="DiffNewRow" CornerRadius="5" Background="#3D3DD68C" Margin="0,4,0,0" Padding="8,3">
                                                <TextBlock x:Name="DiffNew" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBlock x:Name="ClaudeCardText" TextWrapping="Wrap" FontSize="13" MaxHeight="74" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,0,2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <Grid Height="4">
                                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                                <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="Seg0" ScaleX="0" /></Border.RenderTransform></Border>
                                            </Grid>
                                            <TextBlock x:Name="SegLbl0" Text="Read" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <Grid Height="4">
                                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                                <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="Seg1" ScaleX="0" /></Border.RenderTransform></Border>
                                            </Grid>
                                            <TextBlock x:Name="SegLbl1" Text="Edit" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <Grid Height="4">
                                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                                <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="Seg2" ScaleX="0" /></Border.RenderTransform></Border>
                                            </Grid>
                                            <TextBlock x:Name="SegLbl2" Text="Test" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <Grid Height="4">
                                                <Border CornerRadius="2" Background="#33FFFFFF" />
                                                <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="Seg3" ScaleX="0" /></Border.RenderTransform></Border>
                                            </Grid>
                                            <TextBlock x:Name="SegLbl3" Text="Done" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Music -->
                                <Grid x:Name="MusicPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MusicArt" Width="150" Height="150" CornerRadius="20" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3A1520" Offset="0" />
                                                <GradientStop Color="#C23A4C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" />
                                        </Border.Effect>
                                        <TextBlock x:Name="MusicArtGlyph" Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCFFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,10,0">
                                        <TextBlock x:Name="MusicApp" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dimmer}" />
                                        <TextBlock x:Name="MusicTitle" Text="Nothing playing" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock x:Name="MusicArtist" Text="Play something in Spotify or any app" FontSize="14" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                        <Grid x:Name="MusicProgressRow" Margin="0,14,0,0" Height="4">
                                            <Border CornerRadius="2" Background="#33FFFFFF" />
                                            <Border CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="MusicProgress" ScaleX="0" /></Border.RenderTransform></Border>
                                        </Grid>
                                        <Grid x:Name="MusicTimeRow" Margin="0,4,0,0">
                                            <TextBlock x:Name="MusicPos" FontSize="11" Foreground="{StaticResource Dimmer}" />
                                            <TextBlock x:Name="MusicDur" FontSize="11" Foreground="{StaticResource Dimmer}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="MusicPrev" Style="{StaticResource IconBtn}" Content="&#xE892;" Width="42" Height="40" FontSize="18" Click="MusicPrev_Click" />
                                            <Button x:Name="MusicPlay" Style="{StaticResource CircleBtn}" Width="46" Height="46" Margin="8,0" Click="MusicPlay_Click">
                                                <TextBlock x:Name="MusicPlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="#111" />
                                            </Button>
                                            <Button x:Name="MusicNext" Style="{StaticResource IconBtn}" Content="&#xE893;" Width="42" Height="40" FontSize="18" Click="MusicNext_Click" />
                                            <Button x:Name="MusicOpen" Style="{StaticResource PillBtn}" Content="Open Spotify" Margin="16,0,0,0" VerticalAlignment="Center" Click="MusicOpen_Click" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Ask Claude -->
                                <Grid x:Name="ChatPanel" Visibility="Collapsed" Margin="2,2,2,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Run in" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                        <Button x:Name="ChatFolderBtn" Style="{StaticResource PillBtn}" Margin="8,0,0,0" Click="ChatFolderBtn_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ChatFolderText" Text="Choose a folder" Margin="7,0,6,0" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBox x:Name="ChatBox" Grid.Row="1" Margin="0,10,0,10" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="ChatBox_PreviewKeyDown" TextChanged="ChatBox_TextChanged" />
                                    <TextBlock x:Name="ChatPlaceholder" Grid.Row="1" Margin="13,19,0,0" Foreground="{StaticResource Dimmer}" IsHitTestVisible="False"
                                               Text="Ask Claude Code to do something…" />
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="Opens a terminal in that folder and starts Claude with your prompt.  Ctrl+Enter runs it."
                                                   FontSize="11.5" Foreground="{StaticResource Dimmer}" VerticalAlignment="Center" />
                                        <Button x:Name="ChatRun" Style="{StaticResource PillBtn}" Background="#E2885F" Content="Run in Claude Code" HorizontalAlignment="Right" Click="ChatRun_Click" />
                                    </Grid>
                                </Grid>

                                <!-- Focus timer -->
                                <Grid x:Name="TimerPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="164" Height="164" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <local:Ring x:Name="TimerRing" Thickness="7" Progress="1" Fill="#B784F2" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TimerBig" Text="25:00" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="TimerSmall" Text="Focus" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                        <TextBlock x:Name="TimerState" Text="Ready to start" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TimerToday" Text="0 sessions today" Foreground="{StaticResource Dim}" FontSize="13" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Style="{StaticResource PillBtn}" Tag="15" Content="15 min" Margin="0,0,6,6" Click="Preset_Click" />
                                            <Button Style="{StaticResource PillBtn}" Tag="25" Content="25 min" Margin="0,0,6,6" Click="Preset_Click" />
                                            <Button Style="{StaticResource PillBtn}" Tag="45" Content="45 min" Margin="0,0,6,6" Click="Preset_Click" />
                                            <Button Style="{StaticResource PillBtn}" Tag="60" Content="60 min" Margin="0,0,6,6" Click="Preset_Click" />
                                            <Button Style="{StaticResource PillBtn}" Tag="-5" Content="Break 5" Margin="0,0,6,6" Click="Preset_Click" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="TimerStart" Style="{StaticResource PillBtn}" Background="White" Foreground="#111" Content="Start" Padding="22,7" Click="TimerStart_Click" />
                                            <Button x:Name="TimerReset" Style="{StaticResource PillBtn}" Content="Reset" Padding="18,7" Margin="8,0,0,0" Click="TimerReset_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- File tray -->
                                <Grid x:Name="TrayPanel" Visibility="Collapsed">
                                    <ScrollViewer x:Name="TrayScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ItemsControl x:Name="TrayList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:TrayItem}">
                                                        <Grid x:Name="tile" Width="104" Margin="6,0" Background="Transparent" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Path}"
                                                              MouseLeftButtonDown="TrayItem_MouseDown" MouseMove="TrayItem_MouseMove" MouseRightButtonUp="TrayItem_RightClick">
                                                            <StackPanel>
                                                                <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                                                    <Border CornerRadius="20" Background="#1FFFFFFF" />
                                                                    <Border CornerRadius="20" Visibility="{Binding PhotoVisibility}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Image Source="{Binding Thumb}" Width="52" Height="52" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" Margin="0,8,0,0" />
                                                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                            <Button x:Name="rm" Style="{StaticResource CircleBtn}" Background="#46464B" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,-5,2,0" Visibility="Hidden" Tag="{Binding}" Click="TrayRemove_Click" ToolTip="Remove from the tray">
                                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White" />
                                                            </Button>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rm" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid x:Name="TrayDropTile" Width="104" Margin="6,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="TrayDropTile_Click" ToolTip="Add files">
                                                <StackPanel>
                                                    <Grid Width="84" Height="84">
                                                        <Rectangle RadiusX="20" RadiusY="20" Stroke="#4DFFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#B3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="Drop here" FontSize="13" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    <TextBlock Text=" " FontSize="11.5" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid x:Name="TrayPhoneTile" Width="104" Margin="6,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="TrayPhoneTile_Click" ToolTip="Send to or get files from your phone">
                                                <StackPanel>
                                                    <Border Width="84" Height="84" CornerRadius="22">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#3D96FF" Offset="0" />
                                                                <GradientStop Color="#0A5BFF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" />
                                                            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Phone" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    <TextBlock Text="Send · get" FontSize="11.5" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Grid x:Name="SharePanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="172" Height="172" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Border CornerRadius="22" Background="White" Padding="9">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="QrGlow" Color="#3B82F6" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
                                                </Border.Effect>
                                                <Image x:Name="QrImage" RenderOptions.EdgeMode="Aliased" Stretch="Uniform" />
                                            </Border>
                                            <Border x:Name="QrCheck" Width="32" Height="32" CornerRadius="16" Background="#30D158" BorderBrush="#0B1830" BorderThickness="3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-9,0" Visibility="Collapsed">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="24,0,4,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ShareTitle" Text="Scan with your phone" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ShareText" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12.5" Margin="0,3,0,0"
                                                       Text="Point your phone's camera at the code and tap the link. The phone has to be on the same Wi-Fi." />
                                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                                <Ellipse x:Name="ShareDot" Width="8" Height="8" Fill="#8E8E93" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ShareStatus" Text="Waiting for your phone…" Margin="8,0,0,0" FontSize="13.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="ShareFilesRow" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border x:Name="ShareThumb" Width="30" Height="30" CornerRadius="8" Background="#26FFFFFF" />
                                                <TextBlock x:Name="ShareFilesText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                                            </StackPanel>
                                            <Grid Margin="0,10,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Dimmer}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="ShareFoot" Foreground="{StaticResource Dimmer}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button x:Name="ShareStop" Style="{StaticResource PillBtn}" Content="Stop" Padding="16,6" HorizontalAlignment="Right" Click="ShareStop_Click" />
                                            </Grid>
                                            <TextBlock x:Name="ShareUrl" FontSize="11" Foreground="{StaticResource Dimmer}" Margin="0,6,0,0" Cursor="Hand"
                                                       ToolTip="Click to use another network" MouseLeftButtonUp="ShareUrl_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Clipboard -->
                                <Grid x:Name="ClipPanel" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2,0,2">
                                        <ItemsControl x:Name="ClipList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ClipItem}">
                                                    <Border Margin="0,0,8,6" CornerRadius="12" Padding="12,8" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ClipItem_Click" ToolTip="Click to copy again">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#14FFFFFF" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#26FFFFFF" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="46" Height="32" CornerRadius="6" Margin="0,0,10,0" Visibility="{Binding ImageVisibility}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="13" FlowDirection="{Binding Flow}" />
                                                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#73FFFFFF" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                                                                    Tag="{Binding}" Click="ClipRemove_Click" ToolTip="Forget this" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="ClipEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource Dimmer}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Copy something and it shows up here." FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,2" />
                                        <TextBlock Text="Kept in memory only. Never saved to disk, and password managers are skipped." Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Notes -->
                                <Grid x:Name="NotesPanel" Visibility="Collapsed">
                                    <TextBox x:Name="NotesBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             FontSize="14" Padding="14,10" TextChanged="NotesBox_TextChanged" />
                                </Grid>
                            </Grid>

                            <!-- Tab bar -->
                            <Grid Grid.Row="2">
                                <StackPanel x:Name="Tabs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="TabHome" Style="{StaticResource TabBtn}" Tag="Home" Click="Tab_Click" ToolTip="Home">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblHome" Text="Home" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabClaude" Style="{StaticResource TabBtn}" Tag="Claude" Click="Tab_Click" ToolTip="Claude Code">
                                        <StackPanel Orientation="Horizontal">
                                            <local:ClaudeMark x:Name="IcoClaude" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblClaude" Text="Claude" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabMusic" Style="{StaticResource TabBtn}" Tag="Music" Click="Tab_Click" ToolTip="Music">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblMusic" Text="Music" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabChat" Style="{StaticResource TabBtn}" Tag="Chat" Click="Tab_Click" ToolTip="Ask Claude">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblChat" Text="Ask" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabTimer" Style="{StaticResource TabBtn}" Tag="Timer" Click="Tab_Click" ToolTip="Focus timer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblTimer" Text="Focus" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabTray" Style="{StaticResource TabBtn}" Tag="Tray" Click="Tab_Click" ToolTip="File tray">
                                        <StackPanel Orientation="Horizontal">
                                            <local:TrayGlyph x:Name="IcoTray" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblTray" Text="Tray" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabClip" Style="{StaticResource TabBtn}" Tag="Clip" Click="Tab_Click" ToolTip="Clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblClip" Text="Clipboard" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabNotes" Style="{StaticResource TabBtn}" Tag="Notes" Click="Tab_Click" ToolTip="Notes">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblNotes" Text="Notes" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Grid x:Name="VolumeRow" Visibility="Collapsed" HorizontalAlignment="Center" Width="400" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Content="&#xE767;" Click="MuteBtn_Click" ToolTip="Mute" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="VolumeText" Grid.Column="2" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="11" Click="VolumeClose_Click" Margin="6,0,0,0" />
                                </Grid>

                                <Button x:Name="VolumeBtn" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="&#xE767;"
                                        ToolTip="Volume (scroll to change)" Click="VolumeBtn_Click" MouseWheel="VolumeBtn_MouseWheel" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
